{
  "name": "terminal-music-player",
  "version": "1.0.0",
  "description": "Production-grade, feature-rich Terminal/CLI Music Player application with TUI, audio playback, ID3 metadata parsing, visualizer, command palette, and local persistence.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "terminal-music": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "generate-samples": "tsx scripts/generate_sample_tracks.ts",
    "test": "tsx tests/audio_and_store.test.ts"
  },
  "keywords": [
    "terminal",
    "music",
    "tui",
    "player",
    "blessed",
    "audio",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "neo-blessed": "^0.1.9",
    "blessed-contrib": "^4.11.0",
    "music-metadata": "^11.0.0",
    "fuse.js": "^7.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3"
  }
}
